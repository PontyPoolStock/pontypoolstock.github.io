{
  "name": "inventory-system",
  "version": "1.0.0",
  "type": "module",
  "description": "A responsive stock management application for products, categories, and inventory.",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node scripts/api-cache.test.mjs && node --experimental-strip-types scripts/staff-role.test.mjs && node scripts/bulk-products.test.mjs && node scripts/sales-bulk.test.mjs && node scripts/branch-statistics.test.mjs && node scripts/sales-delete.test.mjs && node scripts/notstocked-fields.test.mjs && node scripts/reseller-purchases.test.mjs && node scripts/reseller-page.test.mjs",
    "serve": "node scripts/static-server.mjs",
    "share": "npx --yes localtunnel --port 5500 --subdomain pontypool",
    "server": "json-server --watch data/db.json --port 3000",
    "db:check": "node scripts/db-check.mjs",
    "db:schema": "node scripts/migrate-schema.mjs",
    "db:seed-staff": "node scripts/seed-staff.mjs",
    "db:migrate": "node scripts/migrate-db-json-to-neon.mjs",
    "till": "node scripts/static-server.mjs",
    "electron": "electron .",
    "build:win": "electron-builder --win nsis --x64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdulrahmanSiraj/inventory-management-system.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AbdulrahmanSiraj/inventory-management-system/issues"
  },
  "homepage": "https://github.com/AbdulrahmanSiraj/inventory-management-system#readme",
  "keywords": [],
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3",
    "@neon/functions": "^0.11.0",
    "json-server": "^1.0.0-beta.15",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2"
  },
  "build": {
    "appId": "com.pontypool.stockmanager",
    "productName": "PontyPool Stock Manager",
    "directories": {
      "app": "electron",
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "!**/node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "PontyPoolStockManager-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
